{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cheatsheet",
	"compatibility_date": "2026-07-16",
	"main": "environment/workers/site-worker.ts",
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": ["/*", "!/assets/*"]
	},
	"routes": [
		{ "pattern": "cheatsheet.eccs.dev", "custom_domain": true }
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	}
}
